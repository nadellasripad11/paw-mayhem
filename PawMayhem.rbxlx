<roblox version="4">
  <Item class="Lighting" referent="0">
    <Properties>
      <string name="Name">Lighting</string>
      <Color3 name="Ambient">
        <R>80</R>
        <G>90</G>
        <B>120</B>
      </Color3>
      <float name="Brightness">2.5</float>
      <float name="ClockTime">14.5</float>
      <float name="EnvironmentDiffuseScale">0.6</float>
      <float name="EnvironmentSpecularScale">0.6</float>
      <float name="FogEnd">4000</float>
      <float name="GeographicLatitude">20</float>
